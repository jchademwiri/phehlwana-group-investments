---
import Analytics from '@vercel/analytics/astro';
import Footer from '@/components/shared/Footer.astro';
import Header from '@/components/shared/Header.astro';
import GA4Tracking from '@/components/shared/GA4Tracking.astro';
import CookieConsent from '@/components/shared/CookieConsent.astro';
import '@/styles/starwind.css';
// Self-hosted fonts (replaces the Google Fonts CDN request)
import '@fontsource-variable/inter/opsz.css';
import '@fontsource-variable/inter/opsz-italic.css';
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource-variable/jetbrains-mono/wght.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL or path to an OG image (1200×630 recommended). Defaults to /img/logo.png */
  ogImage?: string;
  /** Open Graph type - 'website' for most pages, 'article' for blog posts */
  ogType?: 'website' | 'article';
  /** Override the canonical URL. Defaults to the current page URL. */
  canonicalUrl?: string;
  /** Hide the site header */
  hideHeader?: boolean;
  /** Hide the site footer */
  hideFooter?: boolean;
}

const { title, description = '', ogImage, ogType = 'website', canonicalUrl, hideHeader = false, hideFooter = false } = Astro.props;
const siteName = 'Phehlwana Group Investments';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const siteUrl = Astro.site ?? new URL('https://phehlwanagroup.co.za');

// ── Canonical URL ──────────────────────────────────────────────────────────────
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;

// ── Open Graph image (must be absolute) ────────────────────────────────────────
const defaultOgImage = new URL('/images/og-default.png', siteUrl).href;
const ogImageUrl = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : new URL(ogImage, siteUrl).href
  : defaultOgImage;

// ── JSON-LD: Organization schema (static, rendered once) ───────────────────────
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Phehlwana Group Investments',
  image: defaultOgImage,
  url: siteUrl.href,
  telephone: '+27126550284',
  email: 'info@phehlwanagroup.co.za',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Office No 06, PKN Office Park, 62 Taaifontein Street',
    addressLocality: 'Montana Park',
    addressRegion: 'Gauteng',
    postalCode: '0182',
    addressCountry: 'ZA',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '07:30',
      closes: '17:00',
    },
  ],
  sameAs: ['https://wa.me/27792947635'],
  description: 'Construction, civil engineering, mechanical services, cleaning, plant hire and security in Pretoria since 2015.',
  foundingDate: '2015',
  vatID: '4520316631',
};

// ── JSON-LD: WebSite schema ────────────────────────────────────────────────────
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl.href,
};

// ── GA4 Measurement ID ─────────────────────────────────────────────────────────
const ga4Id = import.meta.env.PUBLIC_GA4_ID as string | undefined;
---

<!doctype html>
<html lang='en-ZA' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' href='/favicon.ico' />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />
    <meta name='generator' content={Astro.generator} />
    {description && <meta name='description' content={description} />}
    <!-- Preload the hero image for faster LCP - imagesrcset matches the responsive
         variants Picture.astro requests, so mobile doesn't preload the full-size image -->
    <link
      rel="preload"
      href="/images/hero/carousel-2.webp"
      imagesrcset="/images/hero/carousel-2-480w.webp 480w, /images/hero/carousel-2-960w.webp 960w, /images/hero/carousel-2-1600w.webp 1600w"
      imagesizes="100vw"
      as="image"
      type="image/webp"
      fetchpriority="high"
    />

    <title>{fullTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_ZA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD: Organization schema -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    <!-- JSON-LD: WebSite schema -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)}></script>

    <!-- GA4 - only included when PUBLIC_GA4_ID environment variable is set. -->
    <!-- Actual gtag.js is only loaded once the visitor accepts the cookie-consent banner. -->
    {ga4Id && (
      <script is:inline define:vars={{ ga4Id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        window.__initGA4 = function initGA4() {
          if (window.__ga4Loaded) return;
          window.__ga4Loaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
          document.head.appendChild(s);
          gtag('config', ga4Id);
        };

        if (localStorage.getItem('cookie-consent') === 'accepted') {
          window.__initGA4();
        }
      </script>
    )}

    <!-- Theme init - must run before paint to avoid FOUC -->
    <script is:inline>
      function initTheme() {
        const saved = localStorage.getItem('colorTheme');
        if (!saved) {
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches;
          document.documentElement.classList.toggle('dark', prefersDark);
          localStorage.setItem('colorTheme', prefersDark ? 'dark' : 'light');
        } else if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (saved === 'system') {
          const prefersDark = window.matchMedia(
            '(prefers-color-scheme: dark)',
          ).matches;
          document.documentElement.classList.toggle('dark', prefersDark);
        }
      }
      initTheme();
      document.addEventListener('astro:after-swap', initTheme);
    </script>
    <Analytics />
    {ga4Id && <GA4Tracking />}
  </head>
  <body class='flex min-h-screen flex-col'>
    <a
      href='#main-content'
      class='sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:rounded-md focus:text-sm focus:font-medium'
    >
      Skip to main content
    </a>
    {!hideHeader && <Header />}
    <main id='main-content' class='flex-1'>
      <slot />
    </main>
    {!hideFooter && <Footer />}
    {ga4Id && <CookieConsent />}
    <script src='/scripts/animations.js' defer></script>
  </body>
</html>
