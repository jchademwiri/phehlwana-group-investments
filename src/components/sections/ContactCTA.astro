---
/**
 * ContactCTA - reusable bottom call-to-action strip
 *
 * Props:
 *   heading?  - override the default heading
 *   body?     - override the default body text
 *   btnLabel? - override the button label
 *   btnHref?  - override the button href (default: /contact)
 */

interface Props {
  heading?: string;
  body?: string;
  btnLabel?: string;
  btnHref?: string;
}

const {
  heading = 'Have a project in mind?',
  body = 'Contact us for a free, no-obligation quote. We respond within 1 business day.',
  btnLabel = 'Request a Quote',
  btnHref = '/contact',
} = Astro.props;
---

<section class='relative bg-accent/40 border-t border-border py-14 overflow-hidden'>
  <div
    class='absolute inset-0 pointer-events-none [background-image:radial-gradient(color-mix(in_srgb,var(--color-foreground)_18%,transparent)_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_65%_65%_at_50%_50%,black,transparent)]'
    aria-hidden='true'
  >
  </div>
  <div class='relative container mx-auto px-4 text-center'>
    <h2 class='text-2xl font-bold text-foreground mb-3'>{heading}</h2>
    <p class='text-muted-foreground mb-6 max-w-md mx-auto text-sm'>
      {body}
    </p>
    <a
      href={btnHref}
      data-track="cta"
      data-track-label={btnLabel}
      class='inline-flex items-center gap-2 bg-interactive text-interactive-foreground font-semibold px-6 py-3 rounded-lg text-sm shadow-lg hover:bg-interactive/90 transition-colors'
    >
      {btnLabel}
      <svg
        xmlns='http://www.w3.org/2000/svg'
        class='size-4'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'
        aria-hidden='true'
        ><path d='M5 12h14'></path><path d='m12 5 7 7-7 7'></path></svg
      >
    </a>
  </div>
</section>
