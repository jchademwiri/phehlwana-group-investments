---
// Shown only when GA4 is configured (Layout.astro gates its render on ga4Id).
// Gates analytics cookies behind explicit consent, per POPIA.
---

<div
  id='cookie-consent'
  class='hidden fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-xl border border-border bg-card p-4 shadow-lg'
  role='dialog'
  aria-live='polite'
  aria-label='Cookie consent'
>
  <p class='text-sm text-muted-foreground mb-3'>
    We use analytics cookies to understand how visitors use our site. Read our
    <a href='/privacy-policy' class='underline text-foreground'>Privacy Policy</a> to learn more.
  </p>
  <div class='flex gap-3 justify-end'>
    <button
      id='cookie-decline'
      type='button'
      class='text-sm font-medium px-4 py-2 rounded-lg border border-border hover:bg-accent transition-colors'
    >
      Decline
    </button>
    <button
      id='cookie-accept'
      type='button'
      class='text-sm font-medium px-4 py-2 rounded-lg bg-interactive text-interactive-foreground hover:bg-interactive/90 transition-colors'
    >
      Accept
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-consent');
  const acceptBtn = document.getElementById('cookie-accept');
  const declineBtn = document.getElementById('cookie-decline');
  const CONSENT_KEY = 'cookie-consent';

  if (banner && !localStorage.getItem(CONSENT_KEY)) {
    banner.classList.remove('hidden');
  }

  acceptBtn?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'accepted');
    banner?.classList.add('hidden');
    (window as unknown as { __initGA4?: () => void }).__initGA4?.();
  });

  declineBtn?.addEventListener('click', () => {
    localStorage.setItem(CONSENT_KEY, 'declined');
    banner?.classList.add('hidden');
  });
</script>
