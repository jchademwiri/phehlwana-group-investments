---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Picture from '@/components/shared/Picture.astro';
import { categoryList, categoryColours } from '@/lib/categories';

export const prerender = true;

const allProjects = await getCollection('projects', ({ data }) => data.published);

// Sort: featured first, then by year descending
const projects = allProjects.sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.year - a.data.year;
});

const categories = categoryList;
---

<Layout
    title='Our Projects'
    description='Browse completed construction, civil engineering, road, cleaning and plant hire projects by Phehlwana Group Investments nationally across South Africa.'
>
    <!-- Page header -->
    <section class='bg-accent/40 border-b border-border pt-36 pb-14 lg:pt-44'>
        <div class='container mx-auto px-4'>
            <p class='text-sm font-semibold text-primary uppercase tracking-widest mb-2'>
                Our Work
            </p>
            <h1 class='text-4xl font-bold text-foreground mb-3'>Project Portfolio</h1>
            <p class='text-muted-foreground max-w-xl'>
                A selection of completed projects across construction, road maintenance,
                cleaning, and plant hire - delivered nationally across South Africa.
            </p>
        </div>
    </section>

    <!-- Filter + grid -->
    <section class='container mx-auto px-4 py-14'>

        <!-- Category filter -->
        <div
            class='flex flex-wrap gap-2 mb-10'
            role='group'
            aria-label='Filter projects by category'
            id='category-filters'
        >
            {categories.map((cat) => (
                <button
                    type='button'
                    data-filter={cat}
                    class:list={[
                        'filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-colors',
                        cat === 'All'
                            ? 'bg-interactive text-interactive-foreground border-interactive'
                            : 'bg-background text-muted-foreground border-border hover:border-interactive hover:text-foreground',
                    ]}
                    aria-pressed={cat === 'All' ? 'true' : 'false'}
                >
                    {cat}
                </button>
            ))}
        </div>

        <!-- Projects grid -->
        <div
            class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'
            id='projects-grid'
        >
            {projects.map((project) => (
                <article
                    class='project-card group relative bg-card ring-1 ring-border rounded-xl overflow-hidden flex flex-col transition-all duration-300 hover:shadow-lg hover:-translate-y-1'
                    data-category={project.data.category}
                >
                    <!-- Full-card link -->
                    <a
                        href={`/projects/${project.id}`}
                        class='absolute inset-0 z-10'
                        aria-label={`View project: ${project.data.title}`}
                    />

                    <!-- Cover image -->
                    <div class='aspect-16/10 overflow-hidden bg-accent'>
                        <Picture
                            src={project.data.coverImage ?? '/images/placeholder.svg'}
                            alt=''
                            width={640}
                            height={400}
                            loading='lazy'
                            decoding='async'
                            class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                        />
                    </div>

                    <!-- Content -->
                    <div class='flex flex-col flex-1 p-5 gap-3'>
                        <!-- Category + year -->
                        <div class='flex items-center justify-between gap-2'>
                            <span class:list={[
                                'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold',
                                categoryColours[project.data.category]?.badge ?? 'bg-muted text-muted-foreground',
                            ]}>
                                {project.data.category}
                            </span>
                            <span class='text-xs text-muted-foreground'>{project.data.year}</span>
                        </div>

                        <!-- Title -->
                        <h2 class='text-base font-semibold text-foreground leading-snug group-hover:text-secondary-accent transition-colors'>
                            {project.data.title}
                        </h2>

                        <!-- View link -->
                        <div class='flex items-center justify-end gap-2 mt-auto pt-2'>
                            <span class='text-xs font-medium text-primary group-hover:text-secondary-accent transition-colors flex items-center gap-1 shrink-0'>
                                View Details
                                <svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m9 18 6-6-6-6'/></svg>
                            </span>
                        </div>
                    </div>
                </article>
            ))}
        </div>

        <!-- Empty state (shown by JS when filter has no results) -->
        <p
            id='no-results'
            class='hidden text-center text-muted-foreground py-16 text-sm'
            aria-live='polite'
        >
            No projects found in this category.
        </p>
    </section>

    <!-- CTA -->
    <section class='bg-accent/40 border-t border-border py-14'>
        <div class='container mx-auto px-4 text-center'>
            <h2 class='text-2xl font-bold text-foreground mb-3'>Have a project in mind?</h2>
            <p class='text-muted-foreground mb-6 max-w-md mx-auto text-sm'>
                Contact us for a free, no-obligation quote. We respond within 1 business day.
            </p>
            <a
                href='/contact'
                class='inline-flex items-center gap-2 bg-interactive text-interactive-foreground font-semibold px-6 py-3 rounded-lg text-sm hover:bg-interactive/90 transition-colors'
            >
                Request a Quote
                <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'/><path d='m12 5 7 7-7 7'/></svg>
            </a>
        </div>
    </section>
</Layout>

<script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards   = document.querySelectorAll<HTMLElement>('.project-card');
    const noResults = document.getElementById('no-results');
    const validFilters = new Set(Array.from(buttons).map((b) => b.dataset.filter));

    function applyFilter(filter: string, { updateUrl = true } = {}) {
        // Update button states
        buttons.forEach((b) => {
            const active = b.dataset.filter === filter;
            b.setAttribute('aria-pressed', String(active));
            b.classList.toggle('bg-interactive',            active);
            b.classList.toggle('text-primary-foreground',  active);
            b.classList.toggle('border-interactive',        active);
            b.classList.toggle('bg-background',            !active);
            b.classList.toggle('text-muted-foreground',    !active);
            b.classList.toggle('border-border',            !active);
        });

        // Show / hide cards
        let visible = 0;
        cards.forEach((card) => {
            const match = filter === 'All' || card.dataset.category === filter;
            card.style.display = match ? '' : 'none';
            if (match) visible++;
        });

        noResults?.classList.toggle('hidden', visible > 0);

        if (updateUrl) {
            const url = new URL(window.location.href);
            if (filter === 'All') {
                url.searchParams.delete('category');
            } else {
                url.searchParams.set('category', filter);
            }
            history.replaceState(null, '', url);
        }
    }

    buttons.forEach((btn) => {
        btn.addEventListener('click', () => applyFilter(btn.dataset.filter ?? 'All'));
    });

    // Restore filter from ?category= on load (e.g. shared link, reload, back/forward)
    const initialFilter = new URL(window.location.href).searchParams.get('category');
    if (initialFilter && validFilters.has(initialFilter)) {
        applyFilter(initialFilter, { updateUrl: false });
    }
</script>
