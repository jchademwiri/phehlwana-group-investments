---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Picture from '@/components/shared/Picture.astro';

export const prerender = true;

export async function getStaticPaths() {
    const posts = await getCollection('blog', ({ data }) => data.published);
    return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const tocHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3);

function formatDate(date: Date): string {
    return date.toLocaleDateString('en-ZA', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
    });
}

// ── Related posts (most recent others, prioritising shared tags) ───────────
const allPosts = await getCollection('blog', ({ data }) => data.published);
const relatedPosts = allPosts
    .filter((p) => p.id !== post.id)
    .sort((a, b) => {
        const aShared = a.data.tags.filter((t) => post.data.tags.includes(t)).length;
        const bShared = b.data.tags.filter((t) => post.data.tags.includes(t)).length;
        if (aShared !== bShared) return bShared - aShared;
        return b.data.pubDate.getTime() - a.data.pubDate.getTime();
    })
    .slice(0, 3);

const wordCount = post.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const siteUrl = Astro.site ?? new URL('https://phehlwanagroup.co.za');
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    author: {
        '@type': 'Organization',
        name: post.data.author,
    },
    publisher: {
        '@type': 'Organization',
        name: 'Phehlwana Group Investments',
        url: siteUrl.href,
    },
    ...(post.data.coverImage && { image: new URL(post.data.coverImage, siteUrl).href }),
    mainEntityOfPage: new URL(Astro.url.pathname, siteUrl).href,
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl.href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', siteUrl).href },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: new URL(Astro.url.pathname, siteUrl).href },
    ],
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.coverImage}
  ogType="article"
>
    <script type='application/ld+json' set:html={JSON.stringify(articleSchema)} />
    <script type='application/ld+json' set:html={JSON.stringify(breadcrumbSchema)} />

    <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
    <section class='relative min-h-[420px] lg:min-h-[500px] flex items-end overflow-hidden'>

        <!-- Background cover image -->
        <div class='absolute inset-0'>
            <Picture
                src={post.data.coverImage ?? '/images/placeholder.svg'}
                alt=''
                width={1280}
                height={500}
                loading='eager'
                decoding='async'
                class='w-full h-full object-cover'
            />
            <!-- Dark gradient overlay - stronger at bottom where text sits -->
            <div class='absolute inset-0 bg-linear-to-t from-background/95 via-background/50 to-background/20'></div>
        </div>

        <!-- Glassmorphism content panel -->
        <div class='relative z-10 w-full pb-10 pt-40 lg:pb-14 lg:pt-52'>
            <div class='container mx-auto px-4'>

                <!-- Breadcrumb -->
                <nav aria-label='Breadcrumb' class='mb-6'>
                    <ol class='flex items-center gap-1.5 text-xs text-muted-foreground'>
                        <li><a href='/' class='hover:text-foreground transition-colors'>Home</a></li>
                        <li aria-hidden='true'><svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg></li>
                        <li><a href='/blog' class='hover:text-foreground transition-colors'>Blog</a></li>
                        <li aria-hidden='true'><svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><path d='m9 18 6-6-6-6'/></svg></li>
                        <li class='text-foreground font-medium truncate max-w-xs' aria-current='page'>{post.data.title}</li>
                    </ol>
                </nav>

                <div class='max-w-3xl'>
                    <!-- Tags -->
                    {post.data.tags.length > 0 && (
                        <div class='flex flex-wrap gap-2 mb-5'>
                            {post.data.tags.map((tag) => (
                                <span class='inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-background/60 backdrop-blur-sm border border-border/60 text-foreground/80'>
                                    # {tag}
                                </span>
                            ))}
                        </div>
                    )}

                    <!-- Title -->
                    <h1 class='text-3xl sm:text-4xl lg:text-5xl font-bold text-foreground leading-tight tracking-tight mb-4'>
                        {post.data.title}
                    </h1>

                    <!-- Description -->
                    <p class='text-base text-muted-foreground leading-relaxed mb-7'>
                        {post.data.description}
                    </p>

                    <!-- Meta row -->
                    <div class='flex flex-wrap items-center gap-4 text-sm'>
                        <a href='/about' class='flex items-center gap-2 text-foreground/70 hover:text-foreground transition-colors'>
                            <span class='size-7 rounded-full bg-primary/20 backdrop-blur-sm flex items-center justify-center shrink-0'>
                                <svg xmlns='http://www.w3.org/2000/svg' class='size-3.5 text-primary' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='12' cy='8' r='4'/><path d='M20 21a8 8 0 1 0-16 0'/></svg>
                            </span>
                            {post.data.author}
                        </a>
                        <span class='w-px h-4 bg-border/60' aria-hidden='true'></span>
                        <time datetime={post.data.pubDate.toISOString()} class='flex items-center gap-2 text-muted-foreground'>
                            <svg xmlns='http://www.w3.org/2000/svg' class='size-4 text-primary' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>
                            {formatDate(post.data.pubDate)}
                        </time>
                        <span class='w-px h-4 bg-border/60' aria-hidden='true'></span>
                        <span class='flex items-center gap-2 text-muted-foreground'>
                            <svg xmlns='http://www.w3.org/2000/svg' class='size-4 text-primary' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='12' cy='12' r='10'/><polyline points='12 6 12 12 16 14'/></svg>
                            {readingTime} min read
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── Two-column: article + TOC sidebar ────────────────────────────────── -->
    <div class='container mx-auto px-4 py-14'>
        <div class='lg:grid lg:grid-cols-[1fr_240px] lg:gap-14 items-start'>

            <!-- Article -->
            <article class='min-w-0'>
                <div class='prose prose-neutral dark:prose-invert max-w-none prose-lg
                    prose-headings:scroll-mt-28
                    prose-a:font-medium'>
                    <Content />
                </div>
            </article>

            <!-- Sidebar - visible at every breakpoint; the grid only kicks in at lg,
                 so below lg this stacks after the article in normal flow. -->
            <aside class='lg:sticky lg:top-32 lg:self-start space-y-4 mt-10 lg:mt-0' aria-label='Table of contents and sharing'>

                <!-- TOC - collapsible <details> so it doesn't dominate the screen on
                     mobile; open by default on all breakpoints (desktop's card looks
                     the same as before since <details open> renders expanded). -->
                {tocHeadings.length > 0 && (
                    <details open class='bg-card border border-border rounded-xl overflow-hidden group/toc'>
                        <summary class='px-4 py-3 border-b border-border bg-accent/40 cursor-pointer select-none flex items-center justify-between gap-2 lg:cursor-default'>
                            <p class='text-xs font-semibold text-muted-foreground uppercase tracking-widest'>
                                On this page
                            </p>
                            <svg xmlns='http://www.w3.org/2000/svg' class='size-3.5 text-muted-foreground transition-transform group-open/toc:rotate-180 lg:hidden' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m6 9 6 6 6-6'/></svg>
                        </summary>
                        <nav class='p-4'>
                            <ul class='space-y-0.5'>
                                {tocHeadings.map((h) => (
                                    <li>
                                        <a
                                            href={`#${h.slug}`}
                                            class:list={[
                                                'toc-link block py-1.5 text-sm leading-snug transition-colors rounded',
                                                'text-muted-foreground hover:text-foreground font-medium',
                                                'focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-2',
                                                h.depth === 3 && 'pl-3 text-xs font-normal',
                                            ]}
                                        >
                                            {h.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                            <a
                                href='#'
                                class='mt-4 flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-2 rounded transition-colors pt-3 border-t border-border'
                            >
                                <svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m18 15-6-6-6 6'/></svg>
                                Back to top
                            </a>
                        </nav>
                    </details>
                )}

                    <!-- Share -->
                    <div class='bg-card border border-border rounded-xl p-4'>
                        <p class='text-xs font-semibold text-muted-foreground uppercase tracking-widest mb-3'>Share</p>
                        <div class='flex flex-col gap-2'>
                            <a
                                id='whatsapp-share'
                                href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' - ' + Astro.url.href)}`}
                                target='_blank'
                                rel='noopener noreferrer'
                                class='w-full inline-flex items-center justify-center gap-2 text-sm text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-2 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-2'
                            >
                                <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'><path d='M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z'/></svg>
                                Share on WhatsApp
                            </a>
                            <button
                                id='copy-link-btn'
                                type='button'
                                class='w-full inline-flex items-center justify-center gap-2 text-sm text-muted-foreground hover:text-foreground border border-border rounded-lg px-3 py-2 transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-2'
                            >
                                <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/></svg>
                                <span id='copy-link-label' aria-live='polite'>Copy link</span>
                            </button>
                        </div>
                    </div>

                    <!-- CTA -->
                    <div class='bg-accent/40 border border-border rounded-xl p-4 text-center'>
                        <p class='text-xs font-semibold text-foreground mb-1'>Need a quote?</p>
                        <p class='text-xs text-muted-foreground mb-3'>We respond within 1 business day.</p>
                        <a
                            href='/contact'
                            class='inline-flex w-full items-center justify-center gap-1.5 bg-interactive text-primary-foreground font-semibold px-3 py-2 rounded-lg text-xs hover:bg-interactive/90 focus-visible:outline-2 focus-visible:outline-interactive focus-visible:outline-offset-2 transition-colors'
                        >
                            Get in Touch
                            <svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'/><path d='m12 5 7 7-7 7'/></svg>
                        </a>
                    </div>
            </aside>
        </div>
    </div>

    <!-- ── More from the blog ──────────────────────────────────────────────── -->
    {relatedPosts.length > 0 && (
        <section class='border-t border-border bg-accent/20 py-14'>
            <div class='container mx-auto px-4'>
                <h2 class='text-xl font-bold text-foreground mb-8'>More from the Blog</h2>
                <div class='grid grid-cols-1 md:grid-cols-3 gap-6'>
                    {relatedPosts.map((related) => (
                        <article class='group relative bg-card ring-1 ring-border rounded-xl overflow-hidden flex flex-col transition-shadow hover:shadow-lg'>
                            <a
                                href={`/blog/${related.id}`}
                                class='absolute inset-0 z-10'
                                aria-label={`Read: ${related.data.title}`}
                            />
                            <div class='aspect-video overflow-hidden bg-accent'>
                                <Picture
                                    src={related.data.coverImage ?? '/images/placeholder.svg'}
                                    alt=''
                                    width={640}
                                    height={360}
                                    loading='lazy'
                                    decoding='async'
                                    class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                                />
                            </div>
                            <div class='flex flex-col flex-1 p-5 gap-2'>
                                <time datetime={related.data.pubDate.toISOString()} class='text-xs text-muted-foreground'>
                                    {formatDate(related.data.pubDate)}
                                </time>
                                <h3 class='text-base font-semibold text-foreground leading-snug group-hover:text-interactive transition-colors'>
                                    {related.data.title}
                                </h3>
                                <span class='text-xs font-medium text-primary flex items-center gap-1 mt-auto pt-2'>
                                    Read more
                                    <svg xmlns='http://www.w3.org/2000/svg' class='size-3' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m9 18 6-6-6-6'/></svg>
                                </span>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- ── Bottom bar ───────────────────────────────────────────────────────── -->
    <div class='border-t border-border bg-accent/30'>
        <div class='container mx-auto px-4 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4'>
            <a
                href='/blog'
                class='inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors'
            >
                <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5'/><path d='m12 19-7-7 7-7'/></svg>
                Back to Blog
            </a>
            <a
                href='/contact'
                class='inline-flex items-center gap-2 bg-interactive text-primary-foreground font-semibold px-5 py-2.5 rounded-lg text-sm hover:bg-interactive/90 transition-colors'
            >
                Request a Quote
                <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14'/><path d='m12 5 7 7-7 7'/></svg>
            </a>
        </div>
    </div>
</Layout>

<script>
    // ── TOC active heading highlight ──────────────────────────────────────────
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');

    if (tocLinks.length > 0) {
        const headingEls = Array.from(tocLinks)
            .map((link) => {
                const id = link.getAttribute('href')?.slice(1);
                return id ? document.getElementById(id) : null;
            })
            .filter(Boolean) as HTMLElement[];

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        tocLinks.forEach((l) => {
                            l.classList.remove('text-primary', 'font-semibold');
                            l.classList.add('text-muted-foreground');
                        });
                        const active = document.querySelector<HTMLAnchorElement>(
                            `.toc-link[href="#${entry.target.id}"]`,
                        );
                        if (active) {
                            active.classList.add('text-primary', 'font-semibold');
                            active.classList.remove('text-muted-foreground');
                        }
                    }
                });
            },
            { rootMargin: '-20% 0px -70% 0px' },
        );

        headingEls.forEach((el) => observer.observe(el));
    }

    // ── Copy link ─────────────────────────────────────────────────────────────
    const copyBtn   = document.getElementById('copy-link-btn');
    const copyLabel = document.getElementById('copy-link-label');

    copyBtn?.addEventListener('click', async () => {
        try {
            await navigator.clipboard.writeText(window.location.href);
            if (copyLabel) copyLabel.textContent = 'Copied!';
            setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy link'; }, 2000);
        } catch { /* silent fallback */ }
    });
</script>
